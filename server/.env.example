# ==============================================================================
# CORTEX (Constraint-Optimised Real-Time Traffic EXpert) Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment (development | production | testing)
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Database Connection
# Default: Local embedded SQLite file
# Example for PostgreSQL: postgresql://user:password@localhost:5432/cortex_db
DATABASE_URL=sqlite:///cortex.db

# CORS Allowed Origins (comma-separated list for frontend clients)
# Vite React frontend runs on port 5173 by default
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Railway Simulation Parameters
# Distance (in km) trains advance per simulation tick
STEP_KM=10.0

# Time-Expanded Graph (TEG) Parameters
# Time horizon in discrete steps (e.g. 10 slots)
TIME_HORIZON_STEPS=10

# Real-world duration of each time slot in minutes
SLOT_MINUTES=5

# Minimum headway buffer between consecutive edge transitions
H_MIN=1
